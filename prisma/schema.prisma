// Echoes of Lumora - Prisma Schema
// Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// =====================
// AUTH & USER
// =====================

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?        // null for OAuth users
  emailVerified DateTime?
  image         String?
  onboardingCompleted Boolean  @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  accounts      Account[]
  sessions      Session[]
  playerProfile PlayerProfile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =====================
// PLAYER & PROFILE
// =====================

model PlayerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  displayName    String
  level          Int      @default(1)
  experience     Int      @default(0)
  lumens         Int      @default(100)
  energy         Int      @default(100)
  maxEnergy      Int      @default(100)
  energyRefillAt DateTime @default(now())
  sanctuaryLevel Int      @default(1)
  language       String   @default("es")
  lastLoginAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sanctuary Sanctuary?
  inventory Inventory[]
  spirits   PlayerSpirit[]
  guild     GuildMember?
  friends1  Friendship[] @relation("Friend1")
  friends2  Friendship[] @relation("Friend2")
  achievements PlayerAchievement[]
  dailyChallenges PlayerDailyChallenge[]
  blessings  Blessing[]
  chatMessages ChatMessage[]

  @@map("player_profiles")
}

// =====================
// SANCTUARY
// =====================

model Sanctuary {
  id              String   @id @default(cuid())
  playerId        String   @unique
  name            String   @default("Mi Santuario")
  layout          Json     @default("{}")
  globalWater     Int      @default(0)
  globalFire      Int      @default(0)
  globalNature    Int      @default(0)
  globalDream     Int      @default(0)
  globalStar      Int      @default(0)
  lumensPerHour   Int      @default(10)
  lastCollectAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  decorations SanctuaryDecoration[]

  @@map("sanctuaries")
}

model SanctuaryDecoration {
  id          String @id @default(cuid())
  sanctuaryId String
  type        String
  spiritId    String?
  positionX   Int    @default(0)
  positionY   Int    @default(0)
  level       Int    @default(1)
  createdAt   DateTime @default(now())

  sanctuary Sanctuary @relation(fields: [sanctuaryId], references: [id], onDelete: Cascade)

  @@map("sanctuary_decorations")
}

// =====================
// SPIRITS & COLLECTION
// =====================

model SpiritType {
  id          String @id @default(cuid())
  name        String
  nameEn      String
  element     String  // fire, water, dream, nature, star
  rarity      String  // common, uncommon, rare, epic, legendary
  description String
  descEn      String
  basePower   Int     @default(10)
  lumensPerHour Int   @default(5)
  evolveFrom  String?
  imageUrl    String?
  createdAt   DateTime @default(now())

  playerSpirits PlayerSpirit[]

  @@map("spirit_types")
}

model PlayerSpirit {
  id           String   @id @default(cuid())
  playerId     String
  spiritTypeId String
  level        Int      @default(1)
  experience   Int      @default(0)
  isPlaced     Boolean  @default(false)
  placedX      Int?
  placedY      Int?
  acquiredAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  spiritType SpiritType   @relation(fields: [spiritTypeId], references: [id])

  @@map("player_spirits")
}

// =====================
// INVENTORY
// =====================

model Inventory {
  id        String   @id @default(cuid())
  playerId  String
  itemType  String   // spirit, decoration, cosmetic, boost, material
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, itemType, itemId])
  @@map("inventory")
}

// =====================
// GUILD & SOCIAL
// =====================

model Guild {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  emblem      String?
  level       Int      @default(1)
  experience  Int      @default(0)
  maxMembers  Int      @default(50)
  treasury    Int      @default(0)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GuildMember[]
  wars1   GuildWar[] @relation("Attacker")
  wars2   GuildWar[] @relation("Defender")

  @@map("guilds")
}

model GuildMember {
  id       String   @id @default(cuid())
  guildId  String
  playerId String   @unique
  role     String   @default("member") // owner, officer, member
  joinedAt DateTime @default(now())

  guild      Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("guild_members")
}

model Friendship {
  id         String   @id @default(cuid())
  player1Id  String
  player2Id  String
  status     String   @default("pending") // pending, accepted, blocked
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  player1 PlayerProfile @relation("Friend1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2 PlayerProfile @relation("Friend2", fields: [player2Id], references: [id], onDelete: Cascade)

  @@unique([player1Id, player2Id])
  @@map("friendships")
}

// =====================
// CHAT
// =====================

model ChatMessage {
  id          String   @id @default(cuid())
  senderId    String
  guildId     String?  // null for world chat, guildId for guild chat
  content     String
  messageType String   @default("user") // user, system
  createdAt   DateTime @default(now())

  sender PlayerProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([createdAt])
  @@map("chat_messages")
}

// =====================
// EVENTS & GUILD WARS
// =====================

model GuildWar {
  id             String   @id @default(cuid())
  attackerGuildId String
  defenderGuildId String
  attackerScore  Int      @default(0)
  defenderScore  Int      @default(0)
  winnerId       String?
  startsAt       DateTime
  endsAt         DateTime
  status         String   @default("upcoming") // upcoming, active, completed
  createdAt      DateTime @default(now())

  attacker Guild @relation("Attacker", fields: [attackerGuildId], references: [id])
  defender Guild @relation("Defender", fields: [defenderGuildId], references: [id])

  @@map("guild_wars")
}

model WorldEvent {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  description String
  descEn      String
  eventType   String   // awakening, eclipse, seasonal, guild_war
  startsAt    DateTime
  endsAt      DateTime
  multiplier  Float    @default(1.0)
  bonusType   String?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("world_events")
}

// =====================
// PROGRESSION
// =====================

model Achievement {
  id          String @id @default(cuid())
  name        String
  nameEn      String
  description String
  descEn      String
  category    String // collection, social, combat, exploration
  requirement Int
  reward      Json   @default("{}")
  iconUrl     String?

  playerAchievements PlayerAchievement[]

  @@map("achievements")
}

model PlayerAchievement {
  id            String   @id @default(cuid())
  playerId      String
  achievementId String
  progress      Int      @default(0)
  completed     Boolean  @default(false)
  completedAt   DateTime?
  claimed       Boolean  @default(false)
  claimedAt     DateTime?
  createdAt     DateTime @default(now())

  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  achievement Achievement   @relation(fields: [achievementId], references: [id])

  @@unique([playerId, achievementId])
  @@map("player_achievements")
}

model DailyChallenge {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  description String
  descEn      String
  challengeType String // spin_combo, collect_spirit, plant_seeds, etc.
  requirement Int
  reward      Json     @default("{}")
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  playerChallenges PlayerDailyChallenge[]

  @@map("daily_challenges")
}

model PlayerDailyChallenge {
  id          String   @id @default(cuid())
  playerId    String
  challengeId String
  progress    Int      @default(0)
  completed   Boolean  @default(false)
  claimed     Boolean  @default(false)
  createdAt   DateTime @default(now())

  player    PlayerProfile  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  challenge DailyChallenge @relation(fields: [challengeId], references: [id])

  @@unique([playerId, challengeId])
  @@map("player_daily_challenges")
}

model Blessing {
  id          String   @id @default(cuid())
  playerId    String
  day         Int      @default(1)
  claimed     Boolean  @default(false)
  lastClaimAt DateTime @default(now())
  createdAt   DateTime @default(now())

  player PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@map("blessings")
}

// =====================
// SHOP & TRANSACTIONS
// =====================

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  nameEn      String
  description String
  descEn      String
  category    String   // lumens, pass, cosmetic, bundle, boost
  price       Int
  currency    String   @default("lumens") // lumens, real
  content     Json     @default("{}")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("shop_items")
}

model Transaction {
  id        String   @id @default(cuid())
  playerId  String
  type      String   // purchase, reward, trade, daily, event
  amount    Int
  currency  String   @default("lumens")
  itemId    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@map("transactions")
}

// =====================
// GLOBAL WORLD STATE
// =====================

model WorldState {
  id             String   @id @default("lumora_world")
  totalWater     Int      @default(0)
  totalFire      Int      @default(0)
  totalNature    Int      @default(0)
  totalDream     Int      @default(0)
  totalStar      Int      @default(0)
  totalSpins     Int      @default(0)
  totalPlayers   Int      @default(0)
  treeLevel      Int      @default(1)
  updatedAt      DateTime @updatedAt

  @@map("world_state")
}

// =====================
// SPIN RESULTS LOG
// =====================

model SpinLog {
  id          String   @id @default(cuid())
  playerId    String
  symbols     Json     // array of symbol results
  combination String?
  winAmount   Int      @default(0)
  spiritsWon  Json     @default("[]")
  element     String?  // primary element from spin
  createdAt   DateTime @default(now())

  @@map("spin_logs")
}
